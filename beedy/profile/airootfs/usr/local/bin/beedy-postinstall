#!/usr/bin/env bash
# Only for live-system
set -euo pipefail
T="${1:-/mnt/archinstall}"
[[ $EUID -eq 0 ]] || { echo "Need root"; exit 1; }
mountpoint -q "$T" || { echo "$T is not mounted"; exit 1; }

rm -f "$T/etc/os-release"
install -Dm644 /usr/share/beedy/os-release "$T/etc/os-release"
install -Dm644 /usr/share/beedy/os-release "$T/usr/share/beedy/os-release"
printf 'BeedyOS \\r (\\l)\n\n' > "$T/etc/issue"

install -Dm644 /dev/stdin "$T/etc/pacman.d/hooks/beedy-os-release.hook" <<'EOF'
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = filesystem

[Action]
When = PostTransaction
Exec = /usr/bin/sh -c 'rm -f /etc/os-release && cp /usr/share/beedy/os-release /etc/os-release'
EOF

install -Dm755 /usr/share/beedy/lemurs-niri "$T/etc/lemurs/wayland/niri"

for f in "$T"/boot/loader/entries/*.conf; do
  [[ -e $f ]] && sed -i -E 's/^title[[:space:]]+Arch Linux/title   BeedyOS/' "$f"
done
if [[ -f $T/etc/default/grub ]]; then
  sed -i 's/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR="BeedyOS"/' "$T/etc/default/grub"
  arch-chroot "$T" grub-mkconfig -o /boot/grub/grub.cfg
fi

arch-chroot "$T" systemctl --global enable ironbar.service

echo "Everything is okay, please reboot the system."