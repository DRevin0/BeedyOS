{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/Documents/fastfetch/beedy.txt",
    "padding": {
      "top": 2,
      "bottom":0,
      "left": 1,
      "right": 0

    }
  },
  "display": {
    "separator": " ",
    "key": {
      "width": 7
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌────Hardware─────────\u001b[0m"
    },
    {
      "type": "host",
      "key": "󰌢  PC",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      "key": "│ ├󰻠 ",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "│ ├󰑭 ",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": "└ └󰋊 ",
      "keyColor": "green"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌────Software─────────\u001b[0m"
    },
    {
      "type": "os",
      "key": "  OS",
      "keyColor": "yellow"
    },
    {
      "type": "kernel",
      "key": "│ ├󰌽 ",
      "keyColor": "yellow"
    },
    {
      "type": "packages",
      "key": "│ ├󰏗 ",
      "keyColor": "yellow"
    },
    {
      "type": "shell",
      "key": "└ └󰞷 ",
      "keyColor": "yellow"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌────Session──────────\u001b[0m"
    },
    {
      "type": "de",
      "key": "󰧨  DE",
      "keyColor": "blue"
    },
    {
      "type": "wm",
      "key": "│ ├󱂬 ",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": "└ └󰆍 ",
      "keyColor": "blue"
    },
    "break"
  ]
}
